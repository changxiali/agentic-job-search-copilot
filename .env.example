# ==================== 运行模式 ====================
APP_ENV=development
DRY_RUN=true
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
STATE_DB_PATH=data/state.db
LOG_DIR=data/logs

# ==================== 网易邮箱 IMAP ====================
# 163 邮箱填 imap.163.com；126 邮箱填 imap.126.com
EMAIL_IMAP_HOST=imap.163.com
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=your_name@163.com
# 这里必须填“客户端授权码”，不是网页登录密码
EMAIL_AUTH_CODE=replace_with_163_or_126_auth_code
EMAIL_MAILBOX=INBOX
EMAIL_LOOKBACK_DAYS=7
EMAIL_ONLY_UNSEEN=false

# ==================== AI（OpenAI-compatible） ====================
# 示例：https://api.openai.com/v1；也可以换成兼容 /chat/completions 的服务
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_with_api_key
AI_MODEL=replace_with_model_name
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0

# ==================== 飞书开放平台 ====================
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_with_app_secret
# 仅用于首次把你本人加入 Base/日历；二选一填写，手机号请带国家区号
FEISHU_USER_EMAIL=
FEISHU_USER_MOBILE=
# 多维表格 URL 中 /base/ 后的一段通常是 app_token
FEISHU_BITABLE_APP_TOKEN=replace_with_bitable_app_token
# 表格页面 URL 查询参数 table= 后的一段通常是 table_id
FEISHU_BITABLE_TABLE_ID=replace_with_table_id
# V2 自动创建的 Candidate Profile 与 Analytics 数据表
FEISHU_PROFILE_TABLE_ID=replace_with_profile_table_id
FEISHU_ANALYTICS_TABLE_ID=replace_with_analytics_table_id
# V3 会由 scripts/provision_v3.py 自动创建并回填实际 ID
FEISHU_SEARCH_GOALS_TABLE_ID=replace_with_search_goals_table_id
FEISHU_JOB_LEADS_TABLE_ID=replace_with_job_leads_table_id
FEISHU_APPROVAL_TABLE_ID=replace_with_approval_table_id
FEISHU_AGENT_RUNS_TABLE_ID=replace_with_agent_runs_table_id
FEISHU_DECISIONS_TABLE_ID=replace_with_decisions_table_id
FEISHU_ARTIFACTS_TABLE_ID=replace_with_artifacts_table_id
# 要写入的日历 ID。应用身份必须对此日历有 writer/owner 权限
FEISHU_CALENDAR_ID=replace_with_calendar_id
# 默认面试时长（分钟）
FEISHU_DEFAULT_EVENT_DURATION_MINUTES=60

# ==================== V2 上下文文件 ====================
V2_CANDIDATE_INPUT_PATH=data/candidate_profile_input.md
V2_CANDIDATE_PROFILE_PATH=data/candidate_profile.json
V2_ANALYTICS_PATH=data/analytics.json

